YOLO_MODEL=models/yolo11n.pt
PRODUCT_MODEL=models/trained/best.pt
CONFIDENCE_THRESHOLD=0.75
PRODUCTS_CONFIG=configs/products.yaml
CONFIDENCE=0.40
CAMERA_SOURCE=videos/store.mp4
DB_PATH=data/retail.db
LOW_STOCK_DEFAULT=2
QUEUE_ALERT_THRESHOLD=5

# Optional cloud configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Production Application-Level Encryption Layer (Fernet / AES Authenticated Encryption)
