ENCRYPTION_KEY=your-fernet-encryption-key-base64-32bytes
ENCRYPTION_KEY_OLD=
JWT_SECRET=your-jwt-secret-key-here

# AI Copilot Settings
GEMINI_API_KEY=your-gemini-api-key-here
COPILOT_DEFAULT_MODE=offline
GEMINI_MODEL=gemini-3.5-flash
